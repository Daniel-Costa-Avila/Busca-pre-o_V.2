# Rede local dos servicos
API_HOST=127.0.0.1
API_PORT=8000
UI_HOST=127.0.0.1
UI_PORT=8501

# URL publica da API. A UI Streamlit usa este endereco para consultar o backend
# e abrir o painel embutido da plataforma.
API_BASE=https://api.seudominio.com
APP_PUBLIC_BASE_URL=https://api.seudominio.com

# Seguranca
API_TOKEN=troque-por-um-token-longo-e-aleatorio
PASSWORD_AUTH_ENABLED=1
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=troque-essa-senha-inicial
ADMIN_DEFAULT_FULL_NAME=Administrador
USER_SESSION_TTL_SECONDS=43200

# Operacao
HEADLESS=1
DAILY_AUTO_ENABLED=1
DAILY_RUN_TIMES=02:00,12:00,18:00
DAILY_TRIGGER_WINDOW_SECONDS=90
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Ajuste somente se quiser Selenium remoto/Selenoid.
# SELENIUM_REMOTE_URL=http://127.0.0.1:4444/wd/hub
# SELENIUM_BROWSERS=chrome,firefox

# SMTP / Gmail
# SMTP_HOST=smtp.seudominio.com
# SMTP_PORT=587
# SMTP_USE_SSL=0
# SMTP_USE_TLS=1
# SMTP_USER=usuario
# SMTP_PASSWORD=senha
# SMTP_SENDER=no-reply@seudominio.com
# EMAIL_RECIPIENTS=destino1@dominio.com,destino2@dominio.com
# EMAIL_SEND_ON=MANUAL,AUTO_DIARIO

# Ou use o atalho Gmail:
# GMAIL_USER=seuemail@gmail.com
# GMAIL_APP_PASSWORD=senha-de-app
# GMAIL_SENDER=seuemail@gmail.com

# WhatsApp / Twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=seu_token
# TWILIO_WHATSAPP_FROM=whatsapp:+5511999999999
# WHATSAPP_RECIPIENTS=+5511888888888
# WHATSAPP_SEND_ON=MANUAL,AUTO_DIARIO

# Google Drive
# GOOGLE_DRIVE_CREDENTIALS_FILE=/opt/price-monitor/credentials/google-drive.json
# GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
# GOOGLE_DRIVE_SEND_ON=MANUAL,AUTO_DIARIO
